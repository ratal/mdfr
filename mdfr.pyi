class MdfLogger:
    """High-throughput MDF 4.3 streaming logger backed by `mdfr-core`."""

    def __init__(
        self,
        file_name: str,
        layout: str = "sorted",
        compression: CompressionAlgorithm = CompressionAlgorithm.NoCompression,
    ) -> None: ...
    def add_group(self, name: str) -> int:
        """Adds a channel group with a 64-bit microsecond master time channel. Returns the group index."""
        ...
    def add_channel(
        self,
        group: int,
        name: str,
        data_type: int,
        bit_count: int,
        unit: str | None = None,
    ) -> int:
        """Appends a scalar channel (data_type: 0=UintLE, 2=IntLE, 4=FloatLE) and returns a packed channel handle."""
        ...
    def add_vlsd_channel(self, group: int, name: str, data_type: int) -> int:
        """Appends a VLSD channel (data_type: 7=StringUtf8, 10=ByteArray) and returns a packed channel handle."""
        ...
    def add_vlsc_channel(self, group: int, name: str, data_type: int) -> int:
        """Appends an MDF 4.3 VLSC channel and its companion size channel, returning a packed channel handle."""
        ...
    def add_array_channel(
        self,
        group: int,
        name: str,
        data_type: int,
        bit_count: int,
        dims: list[int],
        unit: str | None = None,
    ) -> int:
        """Appends an N-D array channel (CABLOCK) and returns a packed channel handle."""
        ...
    def set_channel_conversion_linear(self, ch_packed: int, p1: float, p2: float) -> None:
        """Sets a linear conversion rule (phys = p1 + p2 * raw) on a channel before start()."""
        ...
    def add_bus_preset(self, bus_type: str, name: str) -> int:
        """Adds an ASAM bus logging preset group ('can', 'can_fd', 'can_fd_vlsd', 'lin', 'ethernet', 'flexray'). Returns group index."""
        ...
    def start(self) -> None:
        """Transitions from schema builder to active streaming logger, writing the MDF 4.3 header hierarchy."""
        ...
    def record_begin(self, group: int) -> None:
        """Begins assembling a record for group."""
        ...
    def record_set_u64(self, ch_packed: int, val: int) -> None:
        """Sets an unsigned integer channel value in the staged record."""
        ...
    def record_set_i64(self, ch_packed: int, val: int) -> None:
        """Sets a signed integer channel value in the staged record."""
        ...
    def record_set_f64(self, ch_packed: int, val: float) -> None:
        """Sets a float channel value in the staged record."""
        ...
    def record_set_bytes(self, ch_packed: int, data: bytes) -> None:
        """Sets a byte slice or UTF-8 string channel value in the staged record."""
        ...
    def record_commit(self, group: int) -> None:
        """Commits the staged record for group."""
        ...
    def checkpoint(self) -> None:
        """Flushes buffered data and patches DL/CG links and cycle counts in place."""
        ...
    def rotate(self, new_file_name: str) -> None:
        """Rotates to new_file_name, finalizing the current file in place and incrementing the sequence index."""
        ...
    def close(self) -> None:
        """Finalizes the MDF 4.3 file in place and closes the logger."""
        ...
    def __enter__(self) -> MdfLogger: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: Any | None,
    ) -> bool | None: ...

